@startuml
title <size:24>Agenda</size>

set separator none
top to bottom direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Component>

System_Boundary("App_boundary", "App", $tags="") {
  Container_Boundary("App.App_boundary", "App", $tags="") {
    Component(App.App.Agenda, "Agenda", $techn="Module", $descr="", $tags="", $link="")
    Component(App.App.Shared, "Shared", $techn="Module", $descr="", $tags="", $link="")
  }

}

Rel(App.App.Agenda, App.App.Shared, "depends on", $techn="", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml